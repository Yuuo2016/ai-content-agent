# ============ LLM 配置（OpenAI 兼容接口）============
# 必填：你的 API Key
LLM_API_KEY=sk-003766abcd3f4c9aa5ecb1cc9dbbd3f1
# 接口地址，按你的服务商填写，例如：
#   OpenAI:      https://api.openai.com/v1
#   DeepSeek:    https://api.deepseek.com/v1
#   通义千问:     https://dashscope.aliyuncs.com/compatible-mode/v1
#   Moonshot:    https://api.moonshot.cn/v1
LLM_BASE_URL=https://api.deepseek.com/v1
# 模型名，例如 deepseek-chat / gpt-4o-mini / qwen-plus
LLM_MODEL=deepseek-chat

# ============ 飞书机器人配置 ============
# 必填：飞书自定义机器人 Webhook 地址
# 获取方式：飞书群 → 设置 → 群机器人 → 添加机器人 → 自定义机器人 → 复制 Webhook
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/fa875e52-6299-4ff4-9b54-eb11d427a47c
# 可选：若机器人开启了"签名校验"，填写密钥；否则留空
FEISHU_SECRET=
