# ============ LLM 配置（OpenAI 兼容接口）============
# 必填：你的 API Key
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# 接口地址，按你的服务商填写，例如：
#   OpenAI:      https://api.openai.com/v1
#   DeepSeek:    https://api.deepseek.com/v1
#   通义千问:     https://dashscope.aliyuncs.com/compatible-mode/v1
#   Moonshot:    https://api.moonshot.cn/v1
LLM_BASE_URL=https://api.deepseek.com/v1
# 模型名，例如 deepseek-chat / gpt-4o-mini / qwen-plus
LLM_MODEL=deepseek-chat

# ============ 飞书机器人配置 ============
# 必填：飞书自定义机器人 Webhook 地址
# 获取方式：飞书群 → 设置 → 群机器人 → 添加机器人 → 自定义机器人 → 复制 Webhook
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx
# 可选：若机器人开启了"签名校验"，填写密钥；否则留空
FEISHU_SECRET=

# ============ 多渠道推送配置（可选，不填则跳过该渠道）============
# 邮件：SMTP 配置（QQ/163/Gmail 等均可用）
# QQ邮箱示例: EMAIL_HOST=smtp.qq.com  EMAIL_PORT=465  EMAIL_USER=xxx@qq.com  EMAIL_PASS=授权码
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
EMAIL_TO=

# 企业微信：群机器人 Webhook 地址
# 获取方式：企业微信群 → 右键 → 添加群机器人 → 复制 Webhook
WECOM_WEBHOOK=
